<div class="post">
  {% comment %} <header class="post-header">
    <h1 class="post-title"><i class="fa-solid fa-tag fa-sm"></i> {{ page.title }}</h1>
    <p class="post-description">an archive of all tags</p>
  </header> {% endcomment %}

  <article class="archive">
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% for tag in site.tags %}
            <tr>
                <td>
                  <a href="{{ '/blog/tag/' | append: tag[0] | slugify | append: '/' | relative_url }}">
                  {{ tag[0] }}
              </a> ({{ tag[1] | size }})
                </td>
            </tr>
          {% endfor %}
      </table>
    </div>
  </article>
</div>